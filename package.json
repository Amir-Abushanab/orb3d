{
  "name": "orb3d-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Orb Studio and the @orb3d packages that power it",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "benchmark": "pnpm --filter @orb3d/core build:lib && node scripts/benchmark.mjs",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@orb3d/*\" build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm skill:validate && pnpm native:check",
    "climate:frames": "pnpm --filter @orb3d/core build:lib && node scripts/climate-effects.mjs",
    "cloud:frames": "pnpm --filter @orb3d/core build:lib && node scripts/cloud-effects.mjs",
    "color:frames": "pnpm --filter @orb3d/core build:lib && node scripts/color-effects.mjs",
    "depcruise": "dependency-cruiser apps packages scripts",
    "dev": "pnpm --filter orb-studio dev",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "native:check": "pnpm --filter @orb3d/core build:lib && node scripts/generate-native.mjs --check",
    "native:generate": "pnpm --filter @orb3d/core build:lib && node scripts/generate-native.mjs",
    "pack:all": "pnpm -r --filter \"@orb3d/*\" exec pnpm pack",
    "parity": "pnpm --filter @orb3d/core build:lib && node scripts/ensure-standalone.mjs && node scripts/parity.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "prerender": "node scripts/ensure-standalone.mjs",
    "preview": "pnpm --filter orb-studio preview",
    "release": "pnpm native:check && pnpm test:packages && node scripts/publish-if-needed.mjs",
    "render": "node scripts/render.mjs",
    "rain:frames": "pnpm --filter @orb3d/core build:lib && node scripts/rain-coalescence.mjs",
    "readme:hero": "node scripts/ensure-standalone.mjs && node scripts/readme-hero.mjs",
    "skill:stale": "pnpm --filter @orb3d/core skill:stale",
    "skill:validate": "pnpm --filter @orb3d/core skill:validate",
    "sun:frames": "pnpm --filter @orb3d/core build:lib && node scripts/sun-lighting.mjs",
    "snow:frames": "pnpm --filter @orb3d/core build:lib && node scripts/snow-effects.mjs",
    "test": "pnpm -r test",
    "test:browser": "pnpm build:packages && node scripts/smoke-browser.mjs",
    "test:packages": "pnpm build:packages && node scripts/smoke-packages.mjs",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version && node scripts/sync-skill-version.mjs",
    "weather:frames": "pnpm --filter @orb3d/core build:lib && node scripts/weather-effects.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "canvaskit-wasm": "^0.42.0",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.15.0"
}
